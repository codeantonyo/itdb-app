# ---- Database (required in production / Vercel) ----------------------
# Any hosted Postgres works: Vercel Postgres, Neon, Supabase, Railway…
# Locally you can leave this unset — the app falls back to data/db.json.
POSTGRES_URL=

# ---- Session signing ---------------------------------------------------
# HMAC key for the httpOnly session cookie. Optional: when unset, a key
# is generated once and stored in the database. Set it on Vercel so a
# database re-seed never invalidates every member's session.
SESSION_SECRET=

# ---- Scheduled jobs ----------------------------------------------------
# Optional. When set, /api/referral/settle only answers Vercel's scheduler,
# which sends it as a Bearer token. Unset, the route is open, which is
# harmless: it only ever pays rewards already owed, once, under the cap.
CRON_SECRET=

# ---- Telegram Mini App auto-login --------------------------------------
# Bot token from @BotFather. Enables validating Telegram initData so
# members stay signed in inside the Mini App. Leave unset to disable.
TELEGRAM_BOT_TOKEN=

# Any random string. Pass the SAME value as `secret_token` when calling
# setWebhook; Telegram echoes it back on every update so /api/telegram/
# webhook can reject forged posts. Strongly recommended.
TELEGRAM_WEBHOOK_SECRET=

# Deep link the bot's "Open ITDB" button points at. Defaults to
# https://t.me/itdbapp_bot/ITDBAPP — only set this if the Mini App's
# short name changes.
TELEGRAM_MINI_APP_URL=

# ---- Transactional email (Brevo) — OTPs really send when set -----------
# Without a key the app runs in dev mode and shows the code on screen.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=ITDB

# ---- Admin -------------------------------------------------------------
# The wallet that receives the "admin" role at registration. No admin
# account is seeded and no password is hard-coded.
ITDB_ADMIN_WALLET=

# ---- Distributor --------------------------------------------------------
# Airdrop distributor. Not used by referral rewards.
DISTRIBUTOR_SECRET=

# ---- ITDB referral rewards ----------------------------------------------
# Secret (S...) of the ITDB distributor, which pays 10,000 ITDB per side for
# every referral held 7 days. Must NOT be the ITDB issuer (issuer payments
# mint). ITDB_REWARDS_SECRET, if set, overrides it. Optional tuning:
#   ITDB_REWARDS_PER_REFERRAL (default 10000), ITDB_REWARDS_DAILY_CAP
#   (default 100000), ITDB_REWARDS_PAUSED=1 to stop sending.
ITDB_SECRET=
